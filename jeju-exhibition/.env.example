PORT=3002
SLOTS_PER_WORD=6
POSE_HOLD_MS=400
# lan: 같은 LAN 참여 / internet: Cloudflare Tunnel을 통한 인터넷 참여
CONNECTION_MODE=lan
# lan은 예약한 LAN IP, internet은 실제 확보한 공개 HTTPS origin. localhost 금지.
PUBLIC_ORIGIN=
# 전시 시작.command가 실행 시 고정 github.io 입구를 자동 지정. 보통 비워 둠.
JOIN_ENTRY_URL=
# 관객 전용 터널 게이트웨이. 앱 PORT와 달라야 함.
TUNNEL_PORT=3003
WIFI_SSID=
# 관객에게 공개할 전용 Wi-Fi의 비밀번호. 운영자 키와 다른 값을 사용.
WIFI_PASSWORD=
# npm run setup이 무작위 키를 생성. 공개 QR / URL에 넣지 않음.
OPERATOR_TOKEN=
EXHIBITION_STRICT=1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=20000
WORD_DEADLINE_MS=20000
OLLAMA_KEEP_ALIVE=8h
# 비워 두면 jeju-exhibition/data/word-cloud.json 에 단어·문장 기록 저장.
WORD_CLOUD_FILE=
# 문장 작성과 별도 검토를 합친 전체 시간 상한
SENTENCE_DEADLINE_MS=18000
