PORT=3002
SLOTS_PER_WORD=6
POSE_HOLD_MS=400
# 공유기에서 서버 IP를 예약한 뒤 설정. localhost / 개발 서버 주소는 사용하지 않음.
PUBLIC_ORIGIN=
WIFI_SSID=
# 관객에게 공개할 전용 Wi-Fi의 비밀번호. 운영자 키와 다른 값을 사용.
WIFI_PASSWORD=
# npm run setup이 무작위 키를 생성. 공개 QR / URL에 넣지 않음.
OPERATOR_TOKEN=
EXHIBITION_STRICT=1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=20000
WORD_DEADLINE_MS=20000
OLLAMA_KEEP_ALIVE=8h
